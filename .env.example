DB_URL=jdbc:postgresql://TU_HOST_POSTGRES:6543/postgres?user=TU_USUARIO_DB&prepareThreshold=0
DB_USER=TU_USUARIO_DB
DB_PASSWORD=TU_PASSWORD_DB
PORT=8080
WHATSAPP=

# Autenticación con Google vía Supabase Auth (opcional).
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=

# Carpeta persistente para fotos de reseñas. Se crea al recibir la primera foto.
REVIEW_UPLOAD_DIR=uploads/reviews

# Opcional: activar los avisos de pedido mediante tu servidor SMTP.
MAIL_ENABLED=false
# Render Free: usar brevo con clave API y remitente verificado.
MAIL_TRANSPORT=smtp
BREVO_API_KEY=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
# Puerto 465: SMTP_SECURE=true, SMTP_STARTTLS=false y SMTP_STARTTLS_REQUIRED=false.
SMTP_SECURE=false
